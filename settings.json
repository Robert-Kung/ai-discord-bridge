{
  "permissions": {
    "deny": [
      "Read(//home/user/.claude/**)",
      "Read(//home/user/.claude-b/**)",
      "Read(//home/user/.claude-bot-a/**)",
      "Read(//home/user/.claude-bot-b/**)",
      "Read(//home/user/**/.credentials.json)",
      "Read(//home/user/**/anthropic-api-key)",
      "Bash(env)",
      "Bash(env:*)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(curl)",
      "Bash(curl:*)",
      "Bash(wget)",
      "Bash(wget:*)"
    ],
    "allow": [
      "WebSearch",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:support.google.com)"
    ]
  },
  "sandbox": {
    "enabled": false
  }
}
